# Application Environment
APPLICATION_ENV=development
APPLICATION_PORT=3123

# Chat Platform Configuration
CHAT_PLATFORM=rocketchat
CHAT_PLATFORM_URL=http://localhost:3969

# Chat Platform Admin Credentials (Replace with actual credentials)
CHAT_PLATFORM_ADMIN_EMAIL=
CHAT_PLATFORM_ADMIN_PASSWORD=

CHAT_PLATFORM_ACCESS_TOKEN=
CHAT_PLATFORM_ADMIN_USER_ID=

# Internal Access Token (must match INTERNAL_ACCESS_TOKEN in mentoring service)
INTERNAL_ACCESS_TOKEN=internal_access_token

# Database URL
DEV_DATABASE_URL=postgres://postgres:postgres@localhost:5432/communications

# Hashing Configuration (Replace with secure random salts in production)
USERNAME_HASH_SALT=username_hash_salt_default
PASSWORD_HASH_SALT=password_hash_salt_default

USERNAME_HASH_LENGTH=8
PASSWORD_HASH_LENGTH=8
